.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 28rpx 28rpx calc(32rpx + env(safe-area-inset-bottom));
  background:
    radial-gradient(circle at top right, rgba(23, 107, 135, 0.14), transparent 30%),
    linear-gradient(180deg, #eef6fa 0%, #f7fbfd 40%, #ffffff 100%);
}

.hero-card,
.form-card {
  border-radius: 32rpx;
  box-sizing: border-box;
}

.hero-card {
  min-height: calc(100vh - 56rpx - env(safe-area-inset-bottom));
  padding: 42rpx 34rpx;
  background: linear-gradient(145deg, #0f766e 0%, #176b87 56%, #155e75 100%);
  color: #ffffff;
  display: flex;
  flex-direction: column;
  justify-content: center;
  box-shadow: 0 20rpx 44rpx rgba(23, 107, 135, 0.2);
}

.hero-compact {
  min-height: auto;
  margin-bottom: 22rpx;
}

.hero-badge {
  width: 120rpx;
  height: 120rpx;
  border-radius: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.16);
  font-size: 30rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.title {
  margin-top: 24rpx;
  font-size: 54rpx;
  font-weight: 700;
  line-height: 1.2;
}

.subtitle {
  margin-top: 16rpx;
  font-size: 30rpx;
  color: rgba(255, 255, 255, 0.94);
}

.hero-desc {
  margin-top: 22rpx;
  font-size: 26rpx;
  line-height: 1.8;
  color: rgba(255, 255, 255, 0.82);
}

.hero-btn {
  margin-top: 36rpx;
  height: 84rpx;
  font-size: 30rpx;
  font-weight: 700;
  background: #ffffff;
  color: #176b87;
}

.form-card {
  padding: 26rpx;
  background: #ffffff;
  border: 1rpx solid #e4ebf2;
  box-shadow: 0 12rpx 30rpx rgba(23, 32, 51, 0.06);
}

.section-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 18rpx;
}

.section-title {
  color: #172033;
  font-size: 32rpx;
  font-weight: 700;
}

.mini-btn {
  margin: 0;
  padding: 0 24rpx;
  height: 60rpx;
  font-size: 24rpx;
  border-radius: 999rpx;
}

.field,
.textarea {
  width: 100%;
  box-sizing: border-box;
  background: #f8fafc;
  border: 1rpx solid #dde4ec;
  border-radius: 20rpx;
  color: #172033;
  font-size: 28rpx;
  margin-bottom: 16rpx;
}

.field {
  height: 76rpx;
  line-height: 76rpx;
  padding: 0 20rpx;
}

.textarea {
  min-height: 188rpx;
  line-height: 42rpx;
  padding: 18rpx 20rpx;
}

.date-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.date-field {
  color: #5b6574;
}

.create-btn {
  height: 78rpx;
  font-size: 30rpx;
  font-weight: 700;
}
