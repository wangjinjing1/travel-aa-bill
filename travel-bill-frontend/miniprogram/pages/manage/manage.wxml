<view class="page">
  <view wx:if="{{!loggedIn}}" class="card empty-card">
    <view class="section-title">计划管理</view>
    <view class="empty-text">请先前往“我的”页面登录，登录后即可查看你创建和加入的旅游计划。</view>
  </view>

  <view wx:else class="page-content">
    <view class="tab-bar">
      <view class="tab {{scope === 'created' ? 'tab-active' : ''}}" data-scope="created" bindtap="switchScope">我创建的旅游计划</view>
      <view class="tab {{scope === 'joined' ? 'tab-active' : ''}}" data-scope="joined" bindtap="switchScope">我加入的旅游计划</view>
    </view>

    <view class="card filter-card">
      <input class="filter-input" maxlength="80" placeholder="计划名称" value="{{filters.destination}}" data-field="destination" bindinput="onFilterInput" />
      <input class="filter-input" maxlength="80" placeholder="创建人" value="{{filters.creatorName}}" data-field="creatorName" bindinput="onFilterInput" />
      <picker mode="date" value="{{filters.createdDate}}" bindchange="onFilterDateChange">
        <view class="filter-input picker-field">{{filters.createdDate || '创建时间'}}</view>
      </picker>
      <view class="filter-actions">
        <button class="ghost-btn action-btn" size="mini" bindtap="clearFilters">清空</button>
        <button class="primary-btn action-btn" size="mini" bindtap="applyFilters">查询</button>
      </view>
    </view>

    <view class="card list-card">
      <view class="section-title">{{scope === 'created' ? '我创建的旅游计划' : '我加入的旅游计划'}}</view>
      <view class="page-indicator" wx:if="{{planTotal > 0}}">
        已加载 {{plans.length}} / {{planTotal}} 条
      </view>

      <scroll-view
        class="plan-scroll"
        scroll-y
        enhanced
        show-scrollbar="false"
        lower-threshold="80"
        bindscrolltolower="loadMorePlans"
      >
        <view wx:if="{{loading && plans.length === 0}}" class="empty-text">加载中...</view>
        <view wx:elif="{{plans.length === 0}}" class="empty-text">没有找到符合条件的计划。</view>

        <view wx:for="{{plans}}" wx:key="id" class="plan-item" data-id="{{item.id}}" bindtap="openPlan">
          <view class="plan-main">
            <view class="plan-title">{{item.destination}}</view>
            <view class="plan-meta">创建人：{{item.creatorName}}</view>
            <view class="plan-meta">创建时间：{{item.createdAtText}}</view>
            <view class="plan-meta">{{item.startDate}} 至 {{item.endDate}}</view>
          </view>
          <view class="status {{item.status === 'OPEN' ? 'open' : 'closed'}}">{{item.status === 'OPEN' ? '进行中' : '已关闭'}}</view>
        </view>

        <view wx:if="{{plans.length > 0}}" class="scroll-footer">
          <button wx:if="{{hasNext}}" class="load-more-btn" bindtap="loadMorePlans" loading="{{loadingMore}}" disabled="{{loadingMore}}">
            {{loadingMore ? '加载中...' : '加载更多'}}
          </button>
          <view wx:else class="empty-text footer-text">已经到底了</view>
        </view>
      </scroll-view>
    </view>
  </view>
</view>
