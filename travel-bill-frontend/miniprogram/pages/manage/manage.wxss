.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, #f3f8fb 0%, #f9fbfd 36%, #ffffff 100%);
}

.card {
  background: #ffffff;
  border: 1rpx solid #e5e9ef;
  border-radius: 28rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 10rpx 28rpx rgba(23, 32, 51, 0.05);
}

.tab-bar {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  margin-bottom: 20rpx;
}

.tab {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #ffffff;
  border: 1rpx solid #d9e4eb;
  color: #5f6977;
  font-size: 25rpx;
  font-weight: 600;
  text-align: center;
  box-sizing: border-box;
}

.tab-active {
  background: #176b87;
  border-color: #176b87;
  color: #ffffff;
  box-shadow: 0 10rpx 24rpx rgba(23, 107, 135, 0.18);
}

.section-title {
  color: #172033;
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
}

.filter-input {
  width: 100%;
  height: 72rpx;
  line-height: 72rpx;
  box-sizing: border-box;
  padding: 0 18rpx;
  margin-bottom: 14rpx;
  border-radius: 18rpx;
  border: 1rpx solid #dde4ec;
  background: #f8fafc;
  color: #172033;
  font-size: 28rpx;
}

.picker-field {
  color: #5f6977;
}

.filter-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
}

.action-btn {
  margin: 0;
  height: 68rpx;
  line-height: normal;
  border-radius: 999rpx;
}

.page-indicator {
  color: #5f6977;
  font-size: 24rpx;
  margin-bottom: 12rpx;
  text-align: center;
}

.plan-scroll {
  height: 760rpx;
  max-height: 760rpx;
}

.plan-item {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  padding: 22rpx 0;
  border-top: 1rpx solid #eef1f5;
}

.plan-item:first-child {
  border-top: none;
  padding-top: 0;
}

.plan-main {
  min-width: 0;
  flex: 1 1 auto;
}

.plan-title {
  color: #172033;
  font-size: 31rpx;
  font-weight: 700;
  line-height: 1.4;
}

.plan-meta,
.empty-text {
  color: #6d7584;
  font-size: 24rpx;
  line-height: 1.7;
}

.status {
  flex: 0 0 auto;
  align-self: flex-start;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
}

.status.open {
  background: #e8f5f1;
  color: #087558;
}

.status.closed {
  background: #f0f2f5;
  color: #626b78;
}

.empty-text {
  text-align: center;
  padding: 24rpx 0;
}

.footer-text {
  padding-top: 12rpx;
}

.scroll-footer {
  padding: 20rpx 0 8rpx;
}

.load-more-btn {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 999rpx;
  background: #f0f7fb;
  color: #176b87;
  font-size: 28rpx;
  border: none;
}

.empty-card {
  margin-top: 24rpx;
}
