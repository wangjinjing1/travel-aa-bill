.page {
  min-height: 100vh;
  padding: 24rpx 24rpx 160rpx;
  background: linear-gradient(180deg, #f6fbff 0%, #f7f8fb 32%, #f5f7fb 100%);
  box-sizing: border-box;
}

.content {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.card {
  background: #ffffff;
  border: 1rpx solid #e4ebf3;
  border-radius: 28rpx;
  box-shadow: 0 10rpx 28rpx rgba(15, 23, 42, 0.06);
  padding: 28rpx;
  box-sizing: border-box;
}

.hero-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.hero-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-wrap: wrap;
  justify-content: flex-end;
}

.status-chip {
  min-width: 120rpx;
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
  text-align: center;
  box-sizing: border-box;
}

.status-open {
  color: #15803d;
  background: #ecfdf3;
}

.status-closed {
  color: #6b7280;
  background: #f3f4f6;
}

.hero-title {
  margin-top: 18rpx;
  font-size: 56rpx;
  line-height: 1.2;
  font-weight: 700;
  color: #111827;
}

.hero-date,
.hero-meta,
.hero-desc,
.hero-meta-row,
.pending-time,
.section-subtitle,
.expense-meta,
.expense-meta-row,
.settlement-meta,
.modal-tip,
.loading-text,
.empty-text,
.pending-tip {
  font-size: 28rpx;
  line-height: 1.6;
  color: #6b7280;
}

.hero-date,
.hero-meta,
.hero-desc {
  margin-top: 12rpx;
}

.hero-meta-row,
.expense-meta-row {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.preview-bar {
  margin-top: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  flex-wrap: wrap;
}

.preview-tag {
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  background: #eff6ff;
  color: #176b87;
  font-size: 26rpx;
  font-weight: 600;
}

.preview-btn {
  min-width: 240rpx;
}

.section-title {
  font-size: 42rpx;
  line-height: 1.3;
  font-weight: 700;
  color: #111827;
}

.section-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.member-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 24rpx;
}

.member-chip {
  padding: 14rpx 24rpx;
  border-radius: 999rpx;
  background: #eef7fb;
  color: #176b87;
  font-size: 28rpx;
  font-weight: 600;
}

.pending-list,
.expense-list,
.settlement-list {
  margin-top: 24rpx;
}

.expense-scroll {
  margin-top: 24rpx;
  height: 760rpx;
  max-height: 760rpx;
}

.pending-item,
.expense-item,
.settlement-item {
  padding: 24rpx 0;
  border-top: 1rpx solid #edf2f7;
}

.pending-item:first-child,
.expense-item:first-child,
.settlement-item:first-child {
  border-top: none;
  padding-top: 0;
}

.pending-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.pending-name,
.expense-note,
.settlement-name {
  font-size: 34rpx;
  line-height: 1.4;
  font-weight: 700;
  color: #111827;
  word-break: break-all;
}

.pending-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.pending-btn,
.modal-btn,
.action-grid-btn,
.export-btn,
.action-btn {
  flex: 1;
}

.mini-edit-btn {
  margin: 0;
  padding: 0 24rpx;
  min-width: 120rpx;
  height: 56rpx;
  line-height: 56rpx;
  border-radius: 999rpx;
  border: 2rpx solid #d8e7ef;
  background: #ffffff;
  color: #176b87;
  font-size: 24rpx;
  flex: 0 0 auto;
}

.action-grid {
  margin-top: 24rpx;
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.expense-item {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.expense-main {
  flex: 1;
  min-width: 0;
}

.expense-amount {
  font-size: 38rpx;
  line-height: 1.2;
  font-weight: 700;
  color: #111827;
  white-space: nowrap;
}

.load-more-btn {
  width: 100%;
  border-radius: 999rpx;
  background: #f0f7fb;
  color: #176b87;
  font-size: 30rpx;
  border: none;
}

.scroll-footer {
  padding: 24rpx 0 8rpx;
}

.primary-btn,
.ghost-btn,
.danger-btn,
.load-more-btn {
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 600;
  padding: 0 32rpx;
  box-sizing: border-box;
}

.primary-btn {
  background: #2d7f9d;
  color: #ffffff;
  border: none;
}

.ghost-btn {
  background: #ffffff;
  color: #176b87;
  border: 2rpx solid #d8e7ef;
}

.danger-btn {
  background: #fff7f7;
  color: #dc2626;
  border: 2rpx solid #fecaca;
}

.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(15, 23, 42, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  box-sizing: border-box;
  z-index: 1000;
}

.modal-card {
  width: 100%;
  background: #ffffff;
  border-radius: 28rpx;
  padding: 32rpx;
  box-sizing: border-box;
}

.modal-title {
  font-size: 38rpx;
  font-weight: 700;
  color: #111827;
}

.modal-tip {
  margin-top: 16rpx;
}

.modal-input {
  width: 100%;
  margin-top: 20rpx;
  padding: 0 24rpx;
  height: 92rpx;
  border-radius: 22rpx;
  background: #f8fafc;
  border: 2rpx solid #e5edf3;
  font-size: 30rpx;
  color: #111827;
  box-sizing: border-box;
}

.picker-input {
  display: flex;
  align-items: center;
  color: #94a3b8;
}

.picker-filled {
  color: #111827;
}

.modal-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
}

.loading-wrap {
  min-height: 60vh;
  display: flex;
  align-items: center;
  justify-content: center;
}

@media (max-width: 420px) {
  .hero-top,
  .section-row {
    flex-direction: column;
    align-items: stretch;
  }

  .hero-actions,
  .pending-actions,
  .action-grid,
  .modal-actions {
    flex-direction: column;
  }

  .expense-item {
    flex-direction: column;
  }
}
