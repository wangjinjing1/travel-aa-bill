# 应用 HTTP 端口。Docker Compose 会把宿主机同端口映射到后端容器。
SERVER_PORT=24975

# MySQL 容器初始化配置。
# MYSQL_HOST_PORT 是宿主机访问 MySQL 的端口，IDEA 本地启动后端时会用到。
MYSQL_ROOT_PASSWORD=travel_bill_password
MYSQL_DATABASE=travel_bill
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_HOST_PORT=24976

# Redis 容器初始化配置。
# REDIS_HOST_PORT 是宿主机访问 Redis 的端口，IDEA 本地启动后端时会用到。
# REDIS_PASSWORD 留空表示本地 Redis 不启用密码。
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_HOST_PORT=24977
REDIS_PASSWORD=

# Spring Boot 数据库连接配置。
# 这里默认写宿主机地址，方便 IDEA 直接启动后端。
# Docker Compose 启动后端容器时，会覆盖为 mysql:3306。
SPRING_DATASOURCE_URL=jdbc:mysql://127.0.0.1:24976/travel_bill?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=travel_bill_password

# Spring Boot Redis 连接配置。
# 这里默认写宿主机地址，方便 IDEA 直接启动后端。
# Docker Compose 启动后端容器时，会覆盖为 redis:6379。
SPRING_DATA_REDIS_HOST=127.0.0.1
SPRING_DATA_REDIS_PORT=24977
SPRING_DATA_REDIS_PASSWORD=
SPRING_DATA_REDIS_DATABASE=0
SPRING_DATA_REDIS_TIMEOUT=5s

# 登录 token 签名密钥。生产环境请改成足够长的随机字符串。
APP_AUTH_TOKEN_SECRET=change-this-secret-before-production
# 登录 token 有效期，单位小时。
APP_AUTH_TOKEN_TTL_HOURS=168
# 密码哈希盐。已有用户密码入库后不要随意修改，否则旧密码将无法校验。
APP_AUTH_PASSWORD_SALT=travel-aa-bill-fixed-password-salt

# 微信登录兼容配置。当前 Web 账号密码登录不依赖它，保留给 /api/auth/wechat-login。
APP_WECHAT_MOCK_LOGIN=false
APP_WECHAT_APP_ID=app-id
APP_WECHAT_APP_SECRET=app-secret

# CORS 允许来源。前后端同项目部署时通常无需调整。
APP_CORS_ALLOWED_ORIGINS=*

# 安全限流配置。
# 超过每分钟请求数会返回 429；超过 24 小时阈值会写入 IP 黑名单。
APP_SECURITY_RATE_LIMIT_MAX_REQUESTS_PER_MINUTE=1000
APP_SECURITY_IP_BLACKLIST_MAX_REQUESTS_PER_24_HOURS=3000

# 默认管理员账号。
# 只有数据库中不存在该用户名时才会创建；已存在时不会覆盖数据库密码。
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=admin
