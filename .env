# 后端服务端口
SERVER_PORT=24975

# 外部 MySQL 配置
SPRING_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3306/travel_bill?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=root

# 外部 Redis 配置；没有密码就留空
SPRING_DATA_REDIS_HOST=127.0.0.1
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=
SPRING_DATA_REDIS_DATABASE=0
SPRING_DATA_REDIS_TIMEOUT=5s

# 登录 token 配置；修改密钥会让已登录用户失效
APP_AUTH_TOKEN_SECRET=change-this-secret-before-production
APP_AUTH_TOKEN_TTL_HOURS=168

# 密码加密盐；已有用户后不要修改，否则旧密码无法校验
APP_AUTH_PASSWORD_SALT=travel-aa-bill-fixed-password-salt

# CORS 允许来源
APP_CORS_ALLOWED_ORIGINS=*

# 限流和 IP 黑名单配置
APP_SECURITY_RATE_LIMIT_MAX_REQUESTS_PER_MINUTE=1000
APP_SECURITY_IP_BLACKLIST_MAX_REQUESTS_PER_24_HOURS=3000

# 默认管理员；只在数据库不存在该账号时创建，不覆盖已有密码
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=admin
